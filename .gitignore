# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
crates/*/target/
.loader-build/

# Tauri codegen — regenerated from tauri.conf.json + capabilities on every build
src-tauri/gen/

# Secrets. The Anthropic API key lives in the macOS Keychain and the updater
# private key belongs outside the repo (~/.tauri/), but a stray one must never
# be committable by accident. The updater PUBLIC key is not a .key file and is
# committed on purpose — release.sh reads it to refuse building with a placeholder.
*.key
*.p12
*.pem
.env
.env.*

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.idea/
*.swp
*~
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
